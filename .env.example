# =============================================================================
# Acme People ATS — configuration
# Copy to .env for local development. On Vercel, set these in Project Settings
# → Environment Variables. Never commit real values.
#
# VITE_* variables are compiled into the browser bundle and are PUBLIC.
# Everything else is server-only and must never be given a VITE_ prefix.
# =============================================================================

# ---- Public (browser) --------------------------------------------------------
# Supabase project URL and the anon/publishable key. Used only for the realtime
# connection in the interview room and live notifications. Every table has RLS
# enabled with no policies, so this key cannot read or write data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- App ---------------------------------------------------------------------
NODE_ENV=production
# Public origin of the site, no trailing slash. Used in email links and CSRF origin checks.
APP_URL=https://your-app.vercel.app
# Timezone used for dates in emails and for attendance days.
APP_TIMEZONE=Asia/Manila
PORT=3001

# ---- Database (server only) --------------------------------------------------
# Supabase → Project Settings → Database → Connection string → Transaction pooler (port 6543).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_POOL_MAX=3
DATABASE_SSL=true

# ---- Security (server only) --------------------------------------------------
# 32+ random characters. Signs realtime channel names and local storage links.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Vercel Cron sends this as a Bearer token; n8n or any scheduler can use it too.
CRON_SECRET=
TRUST_PROXY=true

# ---- Supabase service access (server only) ------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# supabase | local   (local is development-only and refused in production)
STORAGE_DRIVER=supabase
REALTIME_DRIVER=supabase

# ---- Email (server only) -----------------------------------------------------
# resend | smtp | log | none
#   log  = print emails to the server console (development)
#   none = do not send; actions still succeed and report "not configured"
EMAIL_PROVIDER=resend
EMAIL_FROM="Acme People <careers@yourdomain.com>"
EMAIL_REPLY_TO=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# ---- n8n automation (optional, server only) ----------------------------------
# The ATS works fully with N8N_ENABLED=false. When enabled, events are POSTed to
# N8N_WEBHOOK_URL after each action commits; a slow or offline n8n never blocks
# or fails the action. Point this at your tunnel URL when it is running.
N8N_ENABLED=false
N8N_WEBHOOK_URL=
# Sent as the X-N8N-API-KEY header (use a Header Auth credential on the webhook).
N8N_API_KEY=
# If set, each request carries X-Acme-Signature: sha256=<HMAC of the body>.
N8N_SIGNING_SECRET=
N8N_TIMEOUT_MS=4000
# Optional comma-separated allow-list, e.g. application.submitted,interview.scheduled
N8N_EVENTS=
